# Stage 2: Production Runtime Stage
FROM node:22.15.0-bookworm-slim AS runner

# Install runtime utilities and setup non-root user
RUN apt-get update && \
    apt-get install -y curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy built app with correct user permissions applied
COPY --chown=ops:ops --from=builder /app /app
