# syntax=docker/dockerfile:1


# Stage 1: Build Stage
FROM node:22.15.0-bookworm-slim AS builder

# Install native compilation dependencies for sqlite3 and node-gyp
RUN apt-get update && \
    apt-get install -y python3 make g++ curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copy root and subproject package manifests
COPY package*.json ./
COPY packages/ ./packages/
COPY services/gatekeeper/client/package*.json ./gatekeeper/client/
COPY services/gatekeeper/server/package*.json ./gatekeeper/server/

# 2. Install dependencies (including devDependencies needed for tsc)
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

RUN --mount=type=cache,target=/root/.npm \
    cd gatekeeper/client && npm ci --include=dev

RUN --mount=type=cache,target=/root/.npm \
    cd gatekeeper/server && npm ci

# 3. Copy service source code AFTER dependency installation
COPY services/gatekeeper ./gatekeeper/

# 4. Rebuild native modules and execute build tasks
RUN npm rebuild sqlite3
RUN npm run build
RUN cd gatekeeper/client && npm run build
RUN cd gatekeeper/server && npm run build


# Stage 2: Production Runtime Stage
FROM node:22.15.0-bookworm-slim AS runner

# Install runtime utilities and setup non-root user
RUN apt-get update && \
    apt-get install -y curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy built app with correct user permissions applied
COPY --chown=ops:ops --from=builder /app /app

WORKDIR /app/gatekeeper
USER ops

CMD ["node", "server/dist/gatekeeper-api.js"]
