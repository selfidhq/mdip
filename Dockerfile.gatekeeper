# Syntax directive required for advanced BuildKit features
# syntax=docker/dockerfile:1

FROM node:22.15.0-bookworm-slim AS base

RUN apt-get update && \
    apt-get install -y curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Step 1: Copy manifest files only
COPY package*.json ./
COPY services/gatekeeper/client/package*.json ./gatekeeper/client/
COPY services/gatekeeper/server/package*.json ./gatekeeper/server/

# Step 2: Install dependencies with persistent npm cache
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

RUN --mount=type=cache,target=/root/.npm \
    cd gatekeeper/client && npm ci --include=dev

RUN --mount=type=cache,target=/root/.npm \
    cd gatekeeper/server && npm ci

# Step 3: Copy actual source files (Layer invalidates here on code edit, skipping npm ci)
COPY packages/ ./packages/
COPY services/gatekeeper ./gatekeeper/

# Step 4: Build assets
RUN npm rebuild sqlite3 && npm run build
RUN cd gatekeeper/client && npm run build
RUN cd gatekeeper/server && npm run build

WORKDIR /app/gatekeeper
RUN chown -R ops:ops /app
USER ops

CMD ["node", "server/dist/gatekeeper-api.js"]