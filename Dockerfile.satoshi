# syntax=docker/dockerfile:1


# Stage 1: Build Stage
FROM node:22.15.0-bookworm-slim AS builder

# Install build dependencies required for native sqlite3 compilation
RUN apt-get update && \
    apt-get install -y python3 make g++ --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copy package manifests first (Root and Satoshi service)
COPY package*.json ./
COPY packages/ ./packages/
COPY services/mediators/satoshi/package*.json ./satoshi/

# 2. Install dependencies with persistent BuildKit caching
RUN --mount=type=cache,target=/root/.npm \
    npm ci

RUN --mount=type=cache,target=/root/.npm \
    cd satoshi && npm ci

# 3. Copy service source code AFTER dependency installation
COPY services/mediators/satoshi ./satoshi/

# 4. Rebuild native binaries and compile build outputs
RUN npm rebuild sqlite3 && npm run build
RUN cd satoshi && npm run build


# Stage 2: Production Runtime Stage
FROM node:22.15.0-bookworm-slim AS runner

# Create non-root user early
RUN addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy application files and grant permissions in a single zero-overhead step
COPY --chown=ops:ops --from=builder /app /app

WORKDIR /app/satoshi
USER ops

CMD ["node", "dist/satoshi-mediator.js"]
