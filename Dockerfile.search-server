# Use the official Node.js base image (Bullseye allows lenient system user environments)
FROM node:22.15.0-bullseye-slim

# Create the unprivileged user/group
RUN addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 --ingroup ops ops

# Set the working directory
WORKDIR /app

# Copy packages
COPY package*.json ./
COPY packages/ ./packages/
COPY services/search-server ./search-server/

# Install everything perfectly once as root (No scripts ignored, native modules build fine)
RUN npm ci
RUN npm run build

# Change context to your service folder
WORKDIR /app/search-server

# Make sure the app folder is fully owned by the runtime user
RUN chown -R ops:ops /app
USER ops

EXPOSE 4002

# Run...
CMD ["node", "dist/index.js"]