# syntax=docker/dockerfile:1


# Stage 1: Build Stage
FROM node:22.15.0-bullseye-slim AS builder

WORKDIR /app

# 1. Copy package manifests first (Root and search-server)
COPY package*.json ./
COPY packages/ ./packages/
COPY services/search-server/package*.json ./search-server/

# 2. Install dependencies deterministically with BuildKit caching
RUN --mount=type=cache,target=/root/.npm \
    npm ci

RUN --mount=type=cache,target=/root/.npm \
    cd search-server && npm ci

# 3. Copy source code AFTER dependencies are installed
COPY services/search-server ./search-server/

# 4. Build root packages and search-server dist
RUN npm run build
RUN cd search-server && npm run build


# Stage 2: Production Runtime Stage
FROM node:22.15.0-bullseye-slim AS runner

# Install curl in runtime (useful for container healthchecks)
RUN apt-get update && \
    apt-get install -y curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy application files with user permissions assigned in a single zero-cost step
COPY --chown=ops:ops --from=builder /app /app

WORKDIR /app/search-server

EXPOSE 4002
USER ops

CMD ["node", "dist/index.js"]