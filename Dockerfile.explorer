# Use the official Node.js as the base image
FROM node:22.22.2-bullseye-slim

RUN apt-get update && apt-get install -y curl python3 make g++ && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json to the working directory
COPY package*.json ./
COPY packages/ ./packages/

# Install dependencies
RUN npm ci --ignore-scripts
RUN npm rebuild sqlite3
RUN npm run build

COPY services/explorer ./explorer/

WORKDIR /app/explorer

# Set VITE env to use relative API path
ARG VITE_EXPLORER_PORT=4000
ARG VITE_GATEKEEPER_URL=/api
ARG VITE_SEARCH_SERVER=/search-api
ENV VITE_EXPLORER_PORT=${VITE_EXPLORER_PORT}
ENV VITE_GATEKEEPER_URL=${VITE_GATEKEEPER_URL}
ENV VITE_SEARCH_SERVER=http://search-clusterip.development.svc.cluster.local:4002

RUN npm i
RUN npm run build

EXPOSE 4000

# Run...
CMD ["node", "server.js"]
