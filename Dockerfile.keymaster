# syntax=docker/dockerfile:1


# Stage 1: Build & Compile Stage
FROM node:22.15.0-bookworm-slim AS builder

# Install native build tools for sqlite3 compilation
RUN apt-get update && \
    apt-get install -y python3 make g++ --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copy ALL package manifests first (Root, Client, and Server)
# This creates a solid layer lock for npm dependencies across all subprojects
COPY package*.json ./
COPY packages/ ./packages/
COPY services/keymaster/client/package*.json ./keymaster/client/
COPY services/keymaster/server/package*.json ./keymaster/server/

# 2. Install all dependencies using persistent BuildKit caching
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

RUN --mount=type=cache,target=/root/.npm \
    cd keymaster/client && npm ci --include=dev

RUN --mount=type=cache,target=/root/.npm \
    cd keymaster/server && npm ci


COPY services/keymaster ./keymaster/

# 4. Rebuild native modules and execute builds
RUN npm rebuild sqlite3 && npm run build
RUN cd keymaster/client && npm run build
RUN cd keymaster/server && npm run build


# Stage 2: Production Runtime Stage
FROM node:22.15.0-bookworm-slim AS runner

# Create non-root user
RUN addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy application artifacts with user ownership applied instantly
COPY --chown=ops:ops --from=builder /app /app

WORKDIR /app/keymaster
USER ops

CMD ["node", "server/dist/keymaster-api.js"]