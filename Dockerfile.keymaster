# Use the official Node.js as the base image
FROM node:22.15.0-bookworm-slim

RUN addgroup --system --gid 1001 ops
RUN adduser --system --uid 1001 ops

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY services/keymaster/client/package*.json ./keymaster/client/
COPY services/keymaster/server/package*.json ./keymaster/server/

RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
RUN --mount=type=cache,target=/root/.npm cd keymaster/client && npm ci --include=dev
RUN --mount=type=cache,target=/root/.npm cd keymaster/server && npm ci

COPY services/keymaster ./keymaster/

RUN npm rebuild sqlite3
RUN npm run build
RUN cd keymaster/client && npm run build
RUN cd keymaster/server && npm run build

FROM node:22.15.0-bookworm-slim

WORKDIR /app
COPY --from=builder /app /app

WORKDIR /app/keymaster
RUN chown -R ops:ops /app
USER ops

# Run...
CMD ["node", "server/dist/keymaster-api.js"]