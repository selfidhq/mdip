# Stage 2: Production Runtime Stage
FROM node:22.15.0-bookworm-slim AS runner

# Create non-root user early
RUN addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy application files and grant permissions in a single zero-overhead step
COPY --chown=ops:ops --from=builder /app /app

WORKDIR /app/hyperswarm
USER ops

CMD ["node", "dist/hyperswarm-mediator.js"]
