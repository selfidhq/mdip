# syntax=docker/dockerfile:1

FROM node:22.15.0-bookworm-slim AS builder

RUN addgroup --system --gid 1001 ops
RUN adduser --system --uid 1001 ops

# Install Python and other dependencies
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY services/mediators/hyperswarm/package*.json ./hyperswarm/

RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
RUN --mount=type=cache,target=/root/.npm cd hyperswarm && npm ci

COPY services/mediators/hyperswarm ./hyperswarm/
WORKDIR /app/hyperswarm
RUN npm ci && npm run build
RUN chown -R ops:ops /app
USER ops

# Run...
CMD ["node", "dist/hyperswarm-mediator.js"]