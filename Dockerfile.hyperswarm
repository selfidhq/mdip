# syntax=docker/dockerfile:1

# Stage 1: Build & Compile Stage
FROM node:22.15.0-bookworm-slim AS builder

WORKDIR /app

# Install native build tools (needed only during compilation)
RUN apt-get update && \
    apt-get install -y python3 make g++ --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# 1. Copy dependency manifests first to maximize Docker cache hits
COPY package*.json ./
COPY packages/ ./packages/

# 2. Install dependencies with persistent npm cache
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

# 3. Rebuild native modules
RUN npm rebuild sqlite3

# 4. Copy source code AFTER dependencies are installed
# Changes to hyperswarm source will no longer trigger npm ci or npm rebuild
COPY services/mediators/hyperswarm ./hyperswarm/

# 5. Build application binaries/dist
RUN npm run build


# Stage 2: Lean Production Runtime Stage
FROM node:22.15.0-bookworm-slim AS runner

# Create non-root user early
RUN addgroup --system --gid 1001 ops && \
    adduser --system --uid 1001 ops

WORKDIR /app

# Copy built application directly with correct permissions
# Prevents duplicating image size via `RUN chown -R`
COPY --chown=ops:ops --from=builder /app /app

WORKDIR /app/hyperswarm
USER ops

CMD ["node", "dist/hyperswarm-mediator.js"]